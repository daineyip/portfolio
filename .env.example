# The assistant behind /api/chat. Any OpenAI-compatible host of open models works;
# copy this to .env.local and fill in the key.
#
# Groq (the default), Together, OpenRouter, DeepInfra, Fireworks, local Ollama.
CHAT_API_KEY=
# CHAT_BASE_URL=https://api.groq.com/openai/v1
# CHAT_MODEL=qwen/qwen3.8-27b
# Thinking off — the answers are recall, not reasoning, and it halves the bill.
# Values are per-model (qwen3 takes "none"); empty omits the parameter.
# CHAT_REASONING_EFFORT=none
